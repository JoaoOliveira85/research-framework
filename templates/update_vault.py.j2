#!/usr/bin/env python3
"""Standalone vault maintenance entrypoint for {{ spec.name }}."""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent
SCRIPTS = ROOT / "scripts"
PIPELINE = ROOT / "_pipeline"
DATA_VAULT = ROOT / "data_vault"


def _run_python(script: str, *args: str) -> int:
    path = SCRIPTS / script
    if not path.exists():
        print(f"ERROR: missing script: {path}", file=sys.stderr)
        return 2
    rc = subprocess.run([sys.executable, str(path), str(ROOT), *args]).returncode
    # A negative code is a child killed by a signal (an OOM kill, a SIGTERM):
    # an abort. Left negative, the max() over the codes below drops it and the
    # killed script reads as a pass.
    return rc if rc >= 0 else 2


def _reindex() -> int:
    """Rebuild the Layer 1 indexes with the package indexer.

    The same entry point as ``./vault reindex``: there is one writer of
    ``_index.md`` / ``_concepts.md`` / ``_graph.md`` and of the ``AGENTS.md``
    topic index, and it lives in ``research_framework.vault.indexer``. This
    script does not carry a copy. The package is looked up in the vault's own
    ``.venv`` (where ``./vault`` finds it), else in the running interpreter.
    """
    venv_python = ROOT / ".venv" / "bin" / "python"
    python = str(venv_python) if venv_python.exists() else sys.executable
    probe = subprocess.run(
        [python, "-c", "import research_framework.vault.indexer"],
        capture_output=True,
    )
    if probe.returncode != 0:
        print(
            f"ERROR: research-framework is not installed for {python}; "
            f"run: cd {ROOT} && .venv/bin/pip install research-framework",
            file=sys.stderr,
        )
        return 2
    rc = subprocess.run(
        [python, "-m", "research_framework.cli", "reindex", "--vault", str(ROOT)]
    ).returncode
    return rc if rc >= 0 else 2


def _cmd_validate(_: argparse.Namespace) -> int:
    checks = [
        "validate_vault.py",
        "check_template_compliance.py",
        "check_acronym_links.py",
        "check_intent_drift.py",
        "check_code_source_coverage.py",
    ]
    worst = 0
    ran = 0
    for script in checks:
        path = SCRIPTS / script
        if not path.exists():
            continue
        print(f"[validate] running {script}")
        worst = max(worst, _run_python(script))
        ran += 1
    if ran == 0:
        # Skipping every check is not a clean validation.
        print(f"ERROR: no validator scripts found under {SCRIPTS}", file=sys.stderr)
        return 2
    return worst


def _cmd_metrics(args: argparse.Namespace) -> int:
    output = args.output or (PIPELINE / "vault-metrics.json")
    return _run_python("vault_metrics.py", "--output", str(output))


def _cmd_reindex(_: argparse.Namespace) -> int:
    if not DATA_VAULT.exists():
        print(f"ERROR: data_vault directory not found: {DATA_VAULT}", file=sys.stderr)
        return 2
    return _reindex()


def _cmd_refresh(args: argparse.Namespace) -> int:
    rc = _cmd_validate(args)
    if rc == 2:
        return 2
    reindex_rc = _cmd_reindex(args)
    if reindex_rc != 0:
        return reindex_rc
    metrics_rc = _cmd_metrics(args)
    return max(rc, metrics_rc)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="update_vault.py",
        description="Maintain the generated vault in place.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    validate = sub.add_parser("validate", help="Run the vault validation suite")
    validate.set_defaults(func=_cmd_validate)

    reindex = sub.add_parser("reindex", help="Rebuild Layer 1 index files")
    reindex.set_defaults(func=_cmd_reindex)

    metrics = sub.add_parser("metrics", help="Refresh vault metrics JSON")
    metrics.add_argument(
        "--output",
        type=Path,
        default=None,
        help="Override metrics output path",
    )
    metrics.set_defaults(func=_cmd_metrics)

    refresh = sub.add_parser(
        "refresh",
        help="Validate, rebuild indexes, and refresh metrics",
    )
    refresh.add_argument(
        "--output",
        type=Path,
        default=None,
        help="Override metrics output path",
    )
    refresh.set_defaults(func=_cmd_refresh)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
