#!/usr/bin/env bash
# vault — unified entry point for {{ spec.name }}
# Generated by research-framework. Re-generate with:
#   research-framework generate --spec ./research.spec.md --output . --dry-run
set -euo pipefail

VAULT_DIR="{{ vault_dir }}"
VENV_PYTHON="${VAULT_DIR}/.venv/bin/python"
SCRIPTS_DIR="${VAULT_DIR}/scripts"
RV=("${VENV_PYTHON}" -m research_framework.cli)

if [[ ! -f "${VENV_PYTHON}" ]]; then
    echo "ERROR: vault venv not found at ${VAULT_DIR}/.venv"
    echo "Run: cd ${VAULT_DIR} && python -m venv .venv && .venv/bin/pip install research-framework"
    exit 1
fi

# ---------------------------------------------------------------------------
# Auto-commit invariant (spec 050 / Principle X).
#
# Helper that invokes a vault_commit function for verbs that mutate the vault
# *outside* the research-cycle path (research runs are auto-committed by the
# orchestrator itself). Best-effort — failures only WARN.
#
# Usage:
#   _vault_autocommit framework "upgrade to <version>" "<body>"
#   _vault_autocommit vault-output ask "What is X?"
#   _vault_autocommit vault-output write "Topic name"
#
# The title and body are the operator's own words (a question, a topic), so
# they are DATA: they reach Python through the environment and the heredoc is
# quoted, which means the shell expands nothing inside it. Pasting them into
# the source instead made a question that ends in a double quote a
# SyntaxError (no commit, and the verb exited 1 instead of the session's own
# code), read every backslash as an escape, and ran whatever followed three
# double quotes. Never interpolate a value into this heredoc.
# ---------------------------------------------------------------------------
_vault_autocommit() {
    local kind="$1"
    local title="$2"
    local body="${3:-}"
    RV_COMMIT_VAULT="${VAULT_DIR}" \
    RV_COMMIT_KIND="${kind}" \
    RV_COMMIT_TITLE="${title}" \
    RV_COMMIT_BODY="${body}" \
    "${VENV_PYTHON}" - <<'PY' 2>&1 | sed 's/^/[vault-commit] /'
import os
import sys
from pathlib import Path
try:
    from research_framework.pipeline import vault_commit
except Exception as exc:
    print(f"skipped (import failed: {exc})")
    sys.exit(0)
vault = Path(os.environ["RV_COMMIT_VAULT"])
kind = os.environ["RV_COMMIT_KIND"]
title = os.environ["RV_COMMIT_TITLE"]
body = os.environ["RV_COMMIT_BODY"]
try:
    if kind == "framework":
        r = vault_commit.commit_framework_change(vault, title=title, body=body)
    else:
        r = vault_commit.commit_command_output(
            vault, command=title.split(" ", 1)[0], summary=title
        )
except Exception as exc:
    print(f"failed: {exc}")
    sys.exit(0)
if not r.ok:
    print(f"WARN: {r.error}")
elif r.skipped_reason:
    print(f"skipped ({r.skipped_reason})")
else:
    print(f"committed {r.sha[:8] if r.sha else '?'}")
PY
}

CMD="${1:-help}"
shift || true

case "${CMD}" in
  research)
    exec "${RV[@]}" generate --spec "${VAULT_DIR}/research.spec.md" --output "${VAULT_DIR}" --resume "$@"
    ;;
  health)
    exec "${VENV_PYTHON}" "${SCRIPTS_DIR}/vault_health.py" "${VAULT_DIR}" "$@"
    ;;
  audit)
    exec "${VENV_PYTHON}" "${SCRIPTS_DIR}/vault_audit.py" "${VAULT_DIR}" "$@"
    ;;
  ask)
    if ! command -v claude &>/dev/null; then
        echo "ERROR: claude CLI not found."
        echo "Install Claude Code: https://claude.ai/code"
        exit 1
    fi
    cd "${VAULT_DIR}"
    # Capture the user's question for the auto-commit message (spec 050).
    # The session itself runs interactively; we trap its exit so the
    # invariant fires whether the user typed /exit or hit Ctrl-D.
    ASK_TOPIC="${*:-interactive session}"
    set +e
    claude "$@"
    ASK_RC=$?
    set -e
    _vault_autocommit vault-output "ask ${ASK_TOPIC}" "Interactive Claude session"
    exit ${ASK_RC}
    ;;
  write)
    if [[ $# -eq 0 ]]; then
        echo "Usage: ./vault write <topic>"
        exit 1
    fi
    WRITE_TOPIC="$*"
    set +e
    "${VENV_PYTHON}" "${SCRIPTS_DIR}/generate_doc.py" \
        --vault "${VAULT_DIR}" --topic "${WRITE_TOPIC}" \
        --output "${VAULT_DIR}/_output"
    WRITE_RC=$?
    set -e
    _vault_autocommit vault-output "write ${WRITE_TOPIC}" "Document generated by ./vault write"
    exit ${WRITE_RC}
    ;;
  refresh-sources)
    exec "${VENV_PYTHON}" -m research_framework.cli refresh-sources --vault "${VAULT_DIR}" "$@"
    ;;
  regenerate-shim)
    exec "${VENV_PYTHON}" -m research_framework.cli regenerate-shim --vault "${VAULT_DIR}" "$@"
    ;;
  status)
    exec "${VENV_PYTHON}" -m research_framework.cli status --vault "${VAULT_DIR}" "$@"
    ;;
  digest)
    exec "${VENV_PYTHON}" -m research_framework.cli digest --vault "${VAULT_DIR}" "$@"
    ;;
  acceptance)
    exec "${VENV_PYTHON}" -m research_framework.cli acceptance --vault "${VAULT_DIR}" "$@"
    ;;
  wikilinks)
    exec "${VENV_PYTHON}" -m research_framework.cli wikilinks --vault "${VAULT_DIR}" "$@"
    ;;
  re-grade|regrade)
    # spec 066: re-grade quarantined notes against the current credibility
    # model. The verb commits its own reinstatement batch internally
    # (pipeline.vault_commit.commit_regrade), so no _vault_autocommit wrap.
    exec "${VENV_PYTHON}" -m research_framework.cli re-grade --vault "${VAULT_DIR}" "$@"
    ;;
  update)
    # Hardened upgrade flow (spec 027): archive-first version resolution,
    # short-circuit, dirty-tree guard, labelled pre-snapshot, install, health.
    FORCE=0
    UPDATE_ARGS=()
    for arg in "$@"; do
        case "${arg}" in
            --force) FORCE=1 ;;
            *) UPDATE_ARGS+=("${arg}") ;;
        esac
    done
    AUTO_CONFIRM=0
    # bash 3.2 (macOS stock) + `set -u`: expanding an empty array with the
    # plain "${arr[@]}" form is an "unbound variable" error. The
    # "${arr[@]+"${arr[@]}"}" idiom expands to nothing when empty and to the
    # elements otherwise — safe on every supported bash. (spec 009)
    for arg in "${UPDATE_ARGS[@]+"${UPDATE_ARGS[@]}"}"; do
        case "${arg}" in
            --auto-confirm|-y|--non-interactive) AUTO_CONFIRM=1 ;;
        esac
    done
    REPO_URL="${RV_GITHUB_REPO:-https://github.com/JoaoOliveira85/research-framework.git}"
    REF="${RV_GITHUB_REF:-main}"
    TMPDIR_UPDATE="$(mktemp -d)"
    export TMPDIR_UPDATE
    trap 'rm -rf "${TMPDIR_UPDATE}"' EXIT
    echo "[update] Fetching source archive from ${REPO_URL}@${REF} ..."
    if [[ "${REPO_URL}" == file://* ]]; then
        LOCAL_SRC="${REPO_URL#file://}"
        if [[ -d "${LOCAL_SRC}/.git" ]]; then
            git -C "${LOCAL_SRC}" archive "${REF}" | tar -x -C "${TMPDIR_UPDATE}"
        else
            cp -a "${LOCAL_SRC}/." "${TMPDIR_UPDATE}/"
        fi
    else
        ARCHIVE_URL="${REPO_URL%.git}/archive/${REF}.tar.gz"
        curl -fsSL "${ARCHIVE_URL}" | tar -xz -C "${TMPDIR_UPDATE}" --strip-components=1
    fi
    DOWNGRADE_CONFIRMED=${AUTO_CONFIRM}
    # Every value the Python below needs (paths, the two versions, the ref)
    # goes through the environment, and each heredoc is quoted. The target
    # version is read from the archive just fetched and the ref from
    # RV_GITHUB_REF: pasted into the source, either one could close a string
    # literal and run as code before the downgrade and dirty-tree gates.
    _RESOLVE_OUT="$(RV_UPDATE_VAULT="${VAULT_DIR}" "${VENV_PYTHON}" - <<'PY'
import os
from pathlib import Path
from research_framework.pipeline import vault_update

vault = Path(os.environ["RV_UPDATE_VAULT"])
archive = Path(os.environ["TMPDIR_UPDATE"])
local = vault_update.resolve_local_version(vault)
target = vault_update.resolve_target_version(archive)
relation = vault_update.compare_versions(local, target)
print(local)
print(target)
print(relation)
PY
)" || {
        echo "[update] ERROR: failed to resolve framework versions (exit $?)" >&2
        exit 2
    }
    _RESOLVE_LINES=()
    while IFS= read -r line || [[ -n "${line}" ]]; do
        _RESOLVE_LINES+=("${line}")
    done <<< "${_RESOLVE_OUT}"
    if [[ -z "${_RESOLVE_LINES[0]:-}" || -z "${_RESOLVE_LINES[1]:-}" || -z "${_RESOLVE_LINES[2]:-}" ]]; then
        echo "[update] ERROR: version resolution returned incomplete fields (expected 3)" >&2
        exit 2
    fi
    OLD_VERSION="${_RESOLVE_LINES[0]}"
    TARGET_VERSION="${_RESOLVE_LINES[1]}"
    VERSION_RELATION="${_RESOLVE_LINES[2]}"
    if [[ "${VERSION_RELATION}" == "downgrade" && ${DOWNGRADE_CONFIRMED} -eq 0 ]]; then
        if [[ -t 0 ]]; then
            echo "[update] WARNING: downgrade v${OLD_VERSION} → v${TARGET_VERSION}." >&2
            read -r -p "Proceed with downgrade? [y/N] " _DOWNGRADE_ANS
            case "${_DOWNGRADE_ANS}" in
                [yY]|[yY][eE][sS]) DOWNGRADE_CONFIRMED=1 ;;
                *)
                    echo "[update] Refusing downgrade v${OLD_VERSION} → v${TARGET_VERSION}. Set RV_GITHUB_REF and confirm to proceed." >&2
                    exit 2
                    ;;
            esac
        fi
    fi
    _DECISION_OUT="$(RV_UPDATE_OLD="${OLD_VERSION}" \
        RV_UPDATE_TARGET="${TARGET_VERSION}" \
        RV_UPDATE_FORCE="${FORCE}" \
        RV_UPDATE_REF="${REF}" \
        RV_UPDATE_CONFIRMED="${DOWNGRADE_CONFIRMED}" \
        "${VENV_PYTHON}" - <<'PY'
import os
from research_framework.pipeline import vault_update

decision = vault_update.decide(
    os.environ["RV_UPDATE_OLD"],
    os.environ["RV_UPDATE_TARGET"],
    force=os.environ["RV_UPDATE_FORCE"] == "1",
    pinned_ref=os.environ["RV_UPDATE_REF"],
    confirmed=os.environ["RV_UPDATE_CONFIRMED"] == "1",
)
print(decision.action)
print(decision.exit_code)
print(decision.message)
PY
)" || {
        echo "[update] ERROR: update decision failed (exit $?)" >&2
        exit 2
    }
    _DECISION_LINES=()
    while IFS= read -r line || [[ -n "${line}" ]]; do
        _DECISION_LINES+=("${line}")
    done <<< "${_DECISION_OUT}"
    if [[ -z "${_DECISION_LINES[0]:-}" || -z "${_DECISION_LINES[1]:-}" || -z "${_DECISION_LINES[2]:-}" ]]; then
        echo "[update] ERROR: update decision returned incomplete fields (expected 3)" >&2
        exit 2
    fi
    DECISION_ACTION="${_DECISION_LINES[0]}"
    DECISION_EXIT="${_DECISION_LINES[1]}"
    DECISION_MSG="${_DECISION_LINES[2]}"
    if [[ "${DECISION_ACTION}" == "noop" ]]; then
        echo "[update] ${DECISION_MSG}"
        exit 0
    fi
    if [[ "${DECISION_ACTION}" == "refuse" ]]; then
        echo "[update] ${DECISION_MSG}" >&2
        exit "${DECISION_EXIT}"
    fi
    if [[ ${FORCE} -eq 0 ]]; then
        # 0 = clean, 10 = dirty. Any other exit means the check itself failed
        # (a traceback exits 1), and a check that could not look is not a
        # dirty tree: say so instead of telling the operator to commit or
        # stash. Both refuse the update with exit 2.
        set +e
        RV_UPDATE_VAULT="${VAULT_DIR}" "${VENV_PYTHON}" - <<'PY'
import os
from pathlib import Path
from research_framework.pipeline.vault_commit import is_working_tree_dirty
import sys
sys.exit(10 if is_working_tree_dirty(Path(os.environ["RV_UPDATE_VAULT"])) else 0)
PY
        DIRTY_RC=$?
        set -e
        if [[ ${DIRTY_RC} -eq 10 ]]; then
            echo "[update] Working tree is dirty. Commit or stash changes, or re-run with --force." >&2
            exit 2
        elif [[ ${DIRTY_RC} -ne 0 ]]; then
            echo "[update] ERROR: could not check the working tree for uncommitted changes (exit ${DIRTY_RC}); not upgrading." >&2
            exit 2
        fi
    fi
    echo "[update] ${DECISION_MSG}"
    SNAPSHOT_TITLE="$(RV_UPDATE_OLD="${OLD_VERSION}" \
        RV_UPDATE_TARGET="${TARGET_VERSION}" \
        "${VENV_PYTHON}" - <<'PY'
import os
from research_framework.pipeline import vault_update
print(vault_update.snapshot_title(os.environ["RV_UPDATE_OLD"], os.environ["RV_UPDATE_TARGET"]))
PY
)"
    _vault_autocommit framework "${SNAPSHOT_TITLE}" "Pre-upgrade snapshot before framework install."
    echo "[update] Upgrading framework from ${REPO_URL}@${REF} ..."
    if [[ "${REPO_URL}" == file://* ]]; then
        "${VENV_PYTHON}" -m pip install --upgrade "git+${REPO_URL}@${REF}" \
            || { echo "[update] pip upgrade failed"; exit 2; }
    else
        "${VENV_PYTHON}" -m pip install --upgrade "git+${REPO_URL}@${REF}" \
            || { echo "[update] pip upgrade failed"; exit 2; }
    fi
    NEW_VERSION="$("${VENV_PYTHON}" -c 'import importlib.metadata as m; print(m.version("research-framework"))' 2>/dev/null || echo "unknown")"
    # Vault-local scripts/ SHADOW the packaged copies at runtime
    # (_resolve_script prefers the vault file), so a stale one silently defeats
    # a fix that shipped in the wheel. Sync them from the package pip just
    # installed — install.sh cannot do this from a git archive, which has no
    # wheel beside it.
    RV_UPDATE_VAULT="${VAULT_DIR}" "${VENV_PYTHON}" - <<'RVSYNC'
import os
from pathlib import Path

from research_framework.pipeline import vault_update

changed = vault_update.sync_vault_scripts(Path(os.environ["RV_UPDATE_VAULT"]))
if changed:
    print(f"[update] refreshed {len(changed)} vault script(s): {', '.join(changed)}")
RVSYNC
    # A git archive of the repo carries the MAINTAINER dev-setup install.sh at
    # its root (it runs `pip install -e` and would try to pip-install this
    # vault); the end-user installer lives in dist-templates/. A release tarball
    # ships only the end-user one, at the root. Let the tested resolver pick —
    # see vault_update.resolve_installer.
    INSTALLER="$("${VENV_PYTHON}" - <<'RVPY'
import os
from pathlib import Path

from research_framework.pipeline import vault_update

found = vault_update.resolve_installer(Path(os.environ["TMPDIR_UPDATE"]))
print(found or "")
RVPY
)"
    if [[ -n "${INSTALLER}" && -f "${INSTALLER}" ]]; then
        echo "[update] Re-running ${INSTALLER##*/} against ${VAULT_DIR} ..."
        set +e
        # bash-3.2-safe empty-array expansion under `set -u` (see above).
        # --accept-path is the installer's "did you mean this directory?"
        # guard, and it is mandatory in non-interactive mode. During an update
        # the target is this shim's own baked VAULT_DIR, so there is nothing to
        # disambiguate — passing it satisfies the guard without weakening it
        # (the installer still asserts accept_abs == target_abs). Without it
        # the installer exits 2 with "non-interactive install requires
        # --accept-path" and no scaffolding is refreshed.
        bash "${INSTALLER}" "${VAULT_DIR}" --accept-path "${VAULT_DIR}" \
            "${UPDATE_ARGS[@]+"${UPDATE_ARGS[@]}"}"
        INSTALL_RC=$?
        set -e
    else
        echo "[update] WARNING: no end-user install.sh in archive; framework was"
        echo "[update] upgraded but vault scaffolding was NOT refreshed."
        INSTALL_RC=0
    fi
    echo "[update] Running ./vault health ..."
    set +e
    "${VENV_PYTHON}" "${SCRIPTS_DIR}/vault_health.py" "${VAULT_DIR}"
    HEALTH_RC=$?
    set -e
    if [[ ${HEALTH_RC} -ne 0 ]]; then
        echo "[update] ERROR: ./vault health failed (exit ${HEALTH_RC})" >&2
        exit ${HEALTH_RC}
    fi
    _vault_autocommit framework "upgrade to ${NEW_VERSION}" "Framework upgraded via ./vault update (ref=${REF})."
    exit ${INSTALL_RC}
    ;;
  coverage)
    exec "${RV[@]}" coverage --vault "${VAULT_DIR}" "$@"
    ;;
  reindex)
    exec "${RV[@]}" reindex --vault "${VAULT_DIR}" "$@"
    ;;
  export)
    # Versioned claims export for downstream consumers (issue #189).
    exec "${RV[@]}" export --vault "${VAULT_DIR}" "$@"
    ;;
  sync)
    # Manual sync verb — routed through the spec-050 invariant so the commit
    # shape matches the rest of the framework's history. Pushes remain
    # best-effort (the invariant's push policy decides).
    #
    # Spec 077 D5/T004: this arm had no `exit` at all, so `./vault sync`
    # returned whatever the last command left behind — and the last command is
    # an `|| echo`, which always succeeds. The verb therefore always exited 0,
    # by accident rather than by decision. The decision is: **the commit is the
    # contract, the push is not**. A vault whose notes are committed is safe;
    # a push that could not reach a remote is an advisory, and a cron wrapper
    # must not treat "no network" as a failed sync.
    _vault_autocommit vault-output "sync ${1:-manual}" "Manual ./vault sync run"
    SYNC_RC=$?
    cd "${VAULT_DIR}"
    git push 2>&1 || echo "[sync] push skipped (no remote or push failed)"
    exit "${SYNC_RC}"
    ;;
  maintain)
    # Full maintenance flow — requires spec 023 (flow separation +
    # assistant-framework integration; subsumes the pre-018 specs
    # 010 + 012) to be implemented.
    if [[ -f "${SCRIPTS_DIR}/vault_maintain.py" ]]; then
        exec "${VENV_PYTHON}" "${SCRIPTS_DIR}/vault_maintain.py" "${VAULT_DIR}" "$@"
    else
        echo "vault maintain requires spec 023 (flow separation) to be implemented."
        echo "Run './vault health' for the deterministic check or './vault audit' for the full audit."
        exit 1
    fi
    ;;
  help|--help|-h)
    cat <<EOF
Usage: ./vault <command> [args]

{{ spec.name }} — research vault operations

Commands:
  research   Run next research cycle(s)
  health     Deterministic vault health check (fast, no LLM)
  audit      Full audit (add --full for Haiku quality checks)
  ask        Open interactive chat session (requires claude CLI; use /ask inside)
  write      Non-interactive document generation — ./vault write "topic"
  refresh-sources  Run legacy collector scripts under scripts/
  regenerate-shim  Re-render this vault entry script from framework template
  status     Live cycle progress — ./vault status
  digest     Cross-cycle markdown roll-up — ./vault digest
  acceptance Framework-generic acceptance gates — ./vault acceptance
  wikilinks  Repair acronym-wikilink corruption (dry-run; --fix) — ./vault wikilinks
  re-grade   Re-grade quarantined notes vs the credibility model — ./vault re-grade
  update     Pull latest framework from GitHub + re-run install.sh — ./vault update
  coverage   Show coverage target status
  reindex    Rebuild vault index files
  export     Versioned claims export for consumers — ./vault export --claims [--out FILE]
  sync       Commit and push vault notes to git
  maintain   Run full maintenance flow (requires spec 023 — flow separation)
  help       Show this message
EOF
    ;;
  *)
    # Spec 077 FR-012 / D3: an unknown verb is an operator typo, which the
    # exit-code model calls 2 (usage / abort). argparse has always exited 2
    # for an unknown subcommand; this arm exited 1, so the same mistake got
    # two different codes depending on which surface the operator reached
    # first. 1 means "this unit of work is over" — there was no unit of work.
    echo "Unknown command: ${CMD}" >&2
    echo "Run './vault help' for usage." >&2
    exit 2
    ;;
esac
