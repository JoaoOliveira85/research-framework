# {{ spec.name }} — Configuration
# Toggle features and behaviors for agents and responses. Generated by research-framework from
# the vault spec file. bfs_sources is ordered to match the spec's data-source
# priority — primary (code) first, intent sources next, domain last.

citation:
  enabled: true
  format: "ieee-double"
  include_vault_path: true
  include_access_date: true
  include_original_source: true
  # Code-first tag conventions (feature 002):
  classify_sources: true    # Tag each citation [code]/[intent]/[domain]
  code_first_ordering: true # GitHub/file URLs before intent URLs

response:
  include_confidence: true
  include_related_topics: true
  max_notes_per_response: 10
  warn_on_deprecated: true
  flag_knowledge_gaps: true
  # Drift-aware responses (feature 002):
  name_drift_explicitly: true  # When a note has intent_implementation_drift: true,
                               # the response must state both values, not pick one.

budget:
  # The dollar cap and cycle cap live in settings.yaml
  # (pipeline.budget_usd / pipeline.max_cycles), overridable per run via
  # --max-usd / --max-cycles (spec 061). This file no longer duplicates them.
  log_file: "_pipeline/budget-log.md"
  warn_at_percent: {{ (spec.budget.warn_at_pct * 100) | round(0) | int }}

research:
  # The cycle cap (max_recursion_depth) is settings.yaml::pipeline.max_cycles.
  require_validation: true
  min_sources_per_note: 1
  cross_reference: true
  # bfs_sources ordered by data_sources[*].priority from the spec.
  # Primary (code) first; intent sources next; domain last.
  bfs_sources:
{% for ds in spec.data_sources | sort(attribute='priority') -%}
    - name: {{ ds.name | lower | replace(' ', '_') | replace('(', '') | replace(')', '') }}
      priority: {{ ds.priority }}
      role: {{ ds.role }}
      required: {{ ds.required | lower }}
{% endfor %}
