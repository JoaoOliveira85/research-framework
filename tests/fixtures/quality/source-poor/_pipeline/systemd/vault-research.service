# source-poor-quality-fixture — scheduled research
# Install: cp this file to ~/.config/systemd/user/ && systemctl --user enable vault-research
[Unit]
Description=source-poor-quality-fixture vault — research cycle
After=network.target

[Service]
Type=oneshot
ExecStart=/Users/dev/src/research-framework-022-us3/tests/fixtures/quality/source-poor/vault research
WorkingDirectory=/Users/dev/src/research-framework-022-us3/tests/fixtures/quality/source-poor
StandardOutput=append:/Users/dev/src/research-framework-022-us3/tests/fixtures/quality/source-poor/_pipeline/research.log
StandardError=append:/Users/dev/src/research-framework-022-us3/tests/fixtures/quality/source-poor/_pipeline/research.log

[Install]
WantedBy=default.target
